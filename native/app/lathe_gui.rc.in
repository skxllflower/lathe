// The exe's icon (resource 1: vpf's window loads it for its title bar, the taskbar and Alt+Tab; Explorer shows it for
// the file): the Tauri app's own, gui/src-tauri/icons/icon.ico. Configured by native/CMakeLists.txt (the version).
1 ICON "@LATHE_ICON@"

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LATHE_VERSION_COMMAS@
 PRODUCTVERSION @LATHE_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Vacant Systems"
            VALUE "FileDescription", "Lathe"
            VALUE "FileVersion", "@LATHE_VERSION@"
            VALUE "InternalName", "lathe-gui"
            VALUE "OriginalFilename", "lathe-gui.exe"
            VALUE "ProductName", "Lathe"
            VALUE "ProductVersion", "@LATHE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
