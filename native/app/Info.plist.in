<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Lathe.app's Info.plist (vpf_add_standalone_app fills the @VPF_APP_*@ placeholders). Media files dropped on the Dock
     icon open as inputs. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>@VPF_APP_EXECUTABLE@</string>
	<key>CFBundleIconFile</key>
	<string>@VPF_APP_ICON@</string>
	<key>CFBundleIdentifier</key>
	<string>@VPF_APP_BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@VPF_APP_NAME@</string>
	<key>CFBundleDisplayName</key>
	<string>@VPF_APP_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VPF_APP_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VPF_APP_VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Vacant Systems</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Media File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.image</string>
				<string>public.movie</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
